{
  "name": "airline",
  "version": "0.3.0",
  "description": "Symulator linii lotniczej na prawdziwej mapie",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sim.json",
    "check": "npm run typecheck && vitest run",
    "data": "node tools/data/build-world.mjs",
    "predev": "node tools/copy-map-worker.mjs",
    "prebuild": "node tools/copy-map-worker.mjs",
    "postinstall": "node tools/copy-map-worker.mjs",
    "android": "npm run build && cap sync android",
    "calibrate": "tsx tools/data/calibrate.ts"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "maplibre-gl": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
